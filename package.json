{
  "name": "bsf-consulting-backend",
  "version": "1.0.0",
  "description": "Backend für die Website der BSF Consulting AG",
  "main": "server.js",
  "scripts": {
    "start": "node --no-warnings server.js",
    "dev": "node --no-warnings --watch server.js",
    "i18n": "node scripts/i18n.mjs --apply && node scripts/i18n.mjs --verify",
    "i18n:scan": "node scripts/i18n.mjs --scan",
    "i18n:verify": "node scripts/i18n.mjs --verify"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.5.2",
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "node-html-parser": "^7.1.0"
  }
}
